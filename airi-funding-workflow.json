{
  "name": "AIRI \u2014 Funding Opportunity Evaluation & Approval",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "funding-intake",
        "responseMode": "onReceived"
      },
      "id": "9b8c3a60121543fa",
      "name": "Funding Intake (Webhook)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -1160,
        340
      ]
    },
    {
      "parameters": {
        "jsCode": "\n// AIRI organisational profile \u2014 EDIT to match AIRI's real positioning and rules.\nconst AIRI = {\n  name: \"AIRI Foundation\",\n  mission: \"Advance AI literacy and responsible AI education across Canada as a nonprofit.\",\n  stands_for: \"AIRI exists to make AI understandable and safe for everyday Canadians, prioritising underserved communities and public-interest education over commercialisation.\",\n  values: [\"responsible and ethical AI\",\"equitable access\",\"community empowerment\",\"education over commercialisation\",\"transparency\"],\n  focus_areas: [\"AI literacy\",\"AI education\",\"responsible AI\",\"digital skills\",\"community education\"],\n  // Red lines: reasons to decline ON PRINCIPLE even if the opportunity is eligible and topical.\n  red_lines: [\n    \"funders whose core business conflicts with responsible-AI values (e.g. mass surveillance, exploitative data practices)\",\n    \"funding that requires AIRI to endorse or promote a specific product or vendor\",\n    \"opportunities that pull AIRI away from education toward purely commercial delivery\",\n    \"conditions that compromise AIRI's independence or public-interest mission\"\n  ],\n  // Deterministic administrative eligibility:\n  country_eligible: [\"Canada\",\"CA\"],\n  org_types_eligible: [\"nonprofit\",\"charity\",\"not-for-profit\"],\n  funding_min: 5000,\n  funding_max: 250000,\n  currency: \"CAD\",\n  min_lead_days: 7\n};\n\nfunction slugHash(s){ let h=5381; for(let i=0;i<s.length;i++){h=((h<<5)+h)+s.charCodeAt(i); h=h>>>0;} return h.toString(36); }\n\nconst src = $json.body ? $json.body : $json;\nconst title=(src.title||\"\").trim(), funder=(src.funder||\"\").trim(), url=(src.url||\"\").trim();\nconst opportunity_id = url ? \"url_\"+slugHash(url) : \"kv_\"+slugHash((funder+\"|\"+title).toLowerCase());\n\nreturn [{ json: {\n  opportunity_id, title, funder, url,\n  amount: src.amount ?? null, currency: src.currency || AIRI.currency,\n  deadline: src.deadline || null, country: src.country || null,\n  org_type: src.org_type || null, description: src.description || \"\",\n  airi: AIRI\n}}];\n"
      },
      "id": "fc1cf5d448244b5f",
      "name": "Normalize + AIRI Profile",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -940,
        340
      ]
    },
    {
      "parameters": {
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
