      "id": "bd70e33f69ab42f9",
      "name": "Get Existing Record",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        -720,
        340
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst incoming = $('Normalize + AIRI Profile').first().json;\nconst existing = items.length && items[0].json && items[0].json.stage ? items[0].json : null;\nreturn [{ json: { ...incoming, stage: existing ? existing.stage : \"new\", is_new: !existing } }];\n"
      },
      "id": "6585177b9b5b4bec",
      "name": "Resolve Stage",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -500,
        340
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.stage }}",
                    "rightValue": "new",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "pipeline"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        },
        "fallbackOutputName": "already_handled"
      },
      "id": "da044803d3f24c4f",
      "name": "Route by Stage",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        -280,
        340
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst o=$json, A=o.airi, reasons=[];\nif (o.country && !A.country_eligible.map(c=>c.toLowerCase()).includes(String(o.country).toLowerCase()))\n  reasons.push(\"Country not eligible: \"+o.country);\nif (o.org_type && !A.org_types_eligible.map(t=>t.toLowerCase()).includes(String(o.org_type).toLowerCase()))\n  reasons.push(\"Org type not eligible: \"+o.org_type);\nif (o.amount!=null && (o.amount<A.funding_min || o.amount>A.funding_max))\n  reasons.push(\"Amount \"+o.amount+\" outside range \"+A.funding_min+\"-\"+A.funding_max);\nif (o.deadline){ const d=(new Date(o.deadline)-new Date())/86400000;\n  if (isNaN(d)) reasons.push(\"Unparseable deadline: \"+o.deadline);\n  else if (d<A.min_lead_days) reasons.push(\"Deadline too soon (\"+Math.round(d)+\" days lead)\"); }\nreturn [{ json: { ...o, gate_pass: reasons.length===0, gate_reason: reasons.join(\"; \")||\"Passed hard eligibility gate\" } }];\n"
      },
