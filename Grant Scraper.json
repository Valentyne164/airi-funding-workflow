        "jsonBody": "={\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": {{ JSON.stringify(\"Convert the following grant listing into a valid JSON array. Each element must have exactly these fields: title, funder, amount, deadline, country, org_type, description, url. Use plain strings. Output ONLY the JSON array, no markdown, no code fences.\\n\\n---\\n\" + $json.candidates[0].content.parts[0].text) }}\n        }\n      ]\n    }\n  ],\n  \"generationConfig\": {\n    \"responseMimeType\": \"application/json\"\n  }\n}",
