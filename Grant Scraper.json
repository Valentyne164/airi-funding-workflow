        "jsonBody": "{\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"Search the web for CURRENT, OPEN grant funding opportunities relevant to a Canadian AI-literacy nonprofit (AIRI Foundation) whose work spans: AI literacy and education, digital skills, community and public-interest technology, ethical AI and governance, nonprofit digital transformation, applied AI R&D, workforce upskilling, youth STEM, and academic-community partnerships. Include grants from any country (eligibility is filtered downstream). For EACH opportunity you find, list: title, funder, amount, deadline, country, organization type eligible, a one-sentence description, and the source URL. Only include real opportunities you can find with a working source URL. List up to 8.\"\n        }\n      ]\n    }\n  ],\n  \"tools\": [\n    { \"google_search\": {} }\n  ]\n}",
        "options": {}
      },
