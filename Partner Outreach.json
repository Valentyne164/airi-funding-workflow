        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"=You are helping AIRI Foundation find partnership opportunities. Below is a grant that does NOT fit AIRI but may fit OTHER organizations. Find up to 2 REAL, currently-operating organizations (preferably Canadian, or operating in the grant country) whose mission aligns with what this grant funds. For EACH organization provide: name, a one-sentence description, why this grant fits them, and their website URL. Only include real organizations with a working URL.\\n\\nGRANT:\\nTitle: {{ $('Edit Fields').item.json.title }}\\nFunder: {{ $('Edit Fields').item.json.funder }}\\nAmount: {{ $('Edit Fields').item.json.amount }}\\nCountry: {{ $('Edit Fields').item.json.country }}\\nDescription: {{ $('Edit Fields').item.json.description }}\"\n        }\n      ]\n    }\n  ],\n  \"tools\": [\n    { \"google_search\": {} }\n  ]\n}",
        "options": {
          "timeout": 60000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        -768,
        -160
      ],
      "id": "b59ae821-f7d1-4b17-b456-ad4e919f9d65",
