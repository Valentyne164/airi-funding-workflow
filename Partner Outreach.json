    {
      "parameters": {
        "jsCode": "const grant = $('Webhook').item.json.body;\nconst matchedOrgs = $input.first().json.candidates[0].content.parts[0].text;\n\nconst prompt = `You are writing partnership outreach emails for AIRI Foundation. AIRI is a Canadian non-profit dedicated to advancing AI literacy, ethical technology governance, and workflow automation across communities and industries, bridging cutting-edge AI research with practical, community-centered implementation.\n\nAIRI found a grant that fits the organizations listed below (not AIRI itself). For EACH organization listed, write a warm, professional outreach email in which AIRI: (1) introduces itself briefly, (2) notes it came across this grant and believes it is a strong fit for their organization, (3) highlights what the grant offers in relation to their work, and (4) proposes that AIRI co-implement the project with them as a technology and implementation partner. Keep each email concise and appealing.\n\nReturn a JSON array. Each element must have: org_name, org_url, email_subject, email_body. Output ONLY the JSON array, no markdown, no code fences.\n\nGRANT:\nTitle: ${grant.title}\nFunder: ${grant.funder}\nAmount: ${grant.amount}\nCountry: ${grant.country}\nDescription: ${grant.description}\n\nMATCHED ORGANIZATIONS (use ONLY these real organizations, do not invent others):\n${matchedOrgs}`;\n\nreturn [{ json: { prompt } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -592,
        -160
      ],
      "id": "bfc60c1c-e35c-4321-ac0a-080009835d61",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.candidates[0].content.parts[0].text;\nconst emails = JSON.parse(raw);\nconst grant = $('Webhook').item.json.body;\nfunction esc(s){ return String(s||\"\").replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\"); }\n\nconst cards = emails.map(e => `\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:16px 0; border:1px solid #e0e0e0; border-radius:8px; background:#ffffff;\">\n    <tr><td style=\"padding:18px 22px;\">\n      <div style=\"font-size:16px; font-weight:700; color:#1a1a1a;\">${esc(e.org_name)}</div>\n      <div style=\"font-size:13px; margin:2px 0 12px;\"><a href=\"${esc(e.org_url)}\" style=\"color:#2c7a4b; text-decoration:none;\">${esc(e.org_url)}</a></div>\n      <div style=\"font-size:13px; color:#555; margin-bottom:4px;\"><b>Subject:</b> ${esc(e.email_subject)}</div>\n      <div style=\"font-size:13.5px; color:#333; line-height:1.6; white-space:pre-wrap; background:#f9f9f9; border-radius:6px; padding:14px 16px; margin-top:8px;\">${esc(e.email_body)}</div>\n    </td></tr>\n  </table>`).join(\"\");\n\nconst html = `\n<div style=\"background:#f2f4f6; padding:24px 0; font-family:'Segoe UI',Arial,sans-serif;\">\n  <table width=\"660\" cellpadding=\"0\" cellspacing=\"0\" align=\"center\" style=\"margin:0 auto; background:#ffffff; border-radius:10px; overflow:hidden; box-shadow:0 1px 4px rgba(0,0,0,0.08);\">\n    <tr><td style=\"background:#8e44ad; padding:24px 30px;\">\n      <div style=\"color:#fff; font-size:13px; font-weight:700; letter-spacing:0.5px;\">DRAFT — REVIEW BEFORE SENDING</div>\n      <div style=\"color:#fff; font-size:20px; font-weight:700; margin-top:6px;\">Partnership Outreach Suggestions</div>\n    </td></tr>\n    <tr><td style=\"padding:22px 30px;\">\n      <p style=\"font-size:14px; color:#555; line-height:1.6; margin:0 0 6px;\">\n        AIRI declined this grant for its own mission, but it may fit the organizations below.\n        Draft outreach emails are prepared for your review — <b>nothing has been sent.</b>\n      </p>\n      <div style=\"background:#f4f6f6; border-radius:6px; padding:12px 16px; margin:14px 0; font-size:13px; color:#333;\">\n        <b>Grant:</b> ${esc(grant.title)} &nbsp;•&nbsp; <b>Funder:</b> ${esc(grant.funder)} &nbsp;•&nbsp; <b>Amount:</b> ${esc(grant.amount)}\n      </div>\n      ${cards}\n    </td></tr>\n    <tr><td style=\"background:#f8f9fa; padding:16px 30px; border-top:1px solid #eee;\">\n      <div style=\"font-size:12px; color:#999;\">Prepared automatically by AIRI's funding workflow. Copy, edit, and send manually after review.</div>\n    </td></tr>\n  </table>\n</div>`;\n\nreturn [{ json: { html, count: emails.length } }];"
      },
